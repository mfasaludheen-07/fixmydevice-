# FixMyDevice Environment Configuration Example
# Copy this file to .env and adjust values for your environment

# Database Configuration (TiDB Cloud / External MySQL / Local XAMPP)
# For local XAMPP: DB_HOST=localhost, DB_PORT=3306, DB_NAME=fixmydevice, DB_USER=root, DB_PASSWORD=
# For TiDB Cloud Serverless: DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com, DB_PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fixmydevice
DB_USER=root
DB_PASSWORD=

# Application Environment (development or production)
APP_ENV=production
