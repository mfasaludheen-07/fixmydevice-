# FixMyDevice - Production Container Runtime for Vercel
# Uses official FrankenPHP (PHP 8.2 + Caddy application server)
FROM dunglas/frankenphp:1-php8.2-bookworm

# Install MySQL PDO extension
RUN install-php-extensions pdo_mysql

# Copy custom Caddyfile server configuration
COPY Caddyfile /etc/caddy/Caddyfile

# Set working directory to application root
WORKDIR /app

# Copy application files
COPY . /app

# Create and grant proper permissions for local storage and uploads
RUN mkdir -p /app/storage /app/public/uploads \
    && chown -R www-data:www-data /app/storage /app/public/uploads \
    && chmod -R 775 /app/storage /app/public/uploads

# Port contract: FrankenPHP binds to $PORT dynamically assigned by Vercel
ENV PORT=80

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
